{
  "schema_version": 1,
  "analysis": {
    "id": "AB_455nm_first40",
    "reactant_name": "trans-azobenzene",
    "product_name": "cis-azobenzene"
  },
  "inputs": {
    "measurement_spectra": "Spectra_AB_455nm-100mA_first40.dat",
    "reactant_absorptivity": "trans_azobenzene_epsilons.dat",
    "product_absorptivity": "cis_azobenzene_epsilons.dat",
    "led_emission": "LED455nm_raw.dat",
    "timestamps": "log-AHK_first40.csv",
    "formats": {
      "measurement_spectra": {
        "type": "spectragryph_tsv"
      },
      "reactant_absorptivity": {
        "type": "spectragryph_tsv"
      },
      "product_absorptivity": {
        "type": "spectragryph_tsv"
      },
      "led_emission": {
        "type": "spectragryph_tsv"
      },
      "timestamps": {
        "type": "ahk_csv"
      }
    }
  },
  "experiment": {
    "volume_ul": 3020,
    "power_mw": 2.07,
    "power_error_mw": 0.02,
    "thermal_back_reaction_s_1": 7.24e-07,
    "irradiation_wavelength_nm": 455,
    "path_length_cm": 1.0,
    "thermal_forward_reaction_s_1": 0
  },
  "processing": {
    "wavelength_range_nm": [
      250,
      800
    ],
    "led_smoothing": {
      "method": "savgol",
      "window_points": 12,
      "polynomial_order": 3
    },
    "led_baseline": {
      "enabled": true,
      "exclusion_fwhm_multiplier": 10
    }
  },
  "fit": {
    "method": "concentrations",
    "emission_threshold_fraction": 0.01,
    "initial_quantum_yields": {
      "R_to_P": 0.5,
      "P_to_R": 0.5
    },
    "quantum_yield_bounds": {
      "minimum": 0.0,
      "maximum": 1.0
    }
  },
  "plots": {
    "absorbance_residual_percentile": 99
  },
  "outputs": {
    "directory": "results",
    "stem": "Results_AB_455nm_first40_ODEMethod_Concentrations",
    "write_text": true,
    "write_figures": true,
    "write_json": true,
    "write_config": true,
    "write_detailed_data": true,
    "overwrite": false
  }
}
